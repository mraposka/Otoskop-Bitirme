<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ESP32 sıkı şekilde HTTP (cleartext) konuşur; tüm domain'lere izin
         verilmesi yerine ESP32 AP IP'lerini açıkça whitelist'liyoruz. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.4.1</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="false">otoskop.local</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <!-- Geliştirme aşamasında local backend için de cleartext açık.
         Production'da bu base-config kaldırılmalı. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
